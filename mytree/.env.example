# Official Qwen fast preset; server only. Copy to .env.local and supply your own key.
# Prefer: .venv/bin/python scripts/configure_official_ai.py (hidden key input).
# Beijing example; use the region/workspace URL matching your API key.
MYTREE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MYTREE_API_KEY=
MYTREE_VISION_MODEL=qwen3.6-flash
MYTREE_TUTOR_MODEL=qwen3.6-flash
MYTREE_DIAGRAM_MODEL=qwen3.6-flash
MYTREE_MODEL_TIMEOUT=45
MYTREE_REASONING_EFFORT=
MYTREE_ENABLE_THINKING=false
MYTREE_ASR_MODEL=qwen3-asr-flash
MYTREE_ASR_PROTOCOL=qwen
MYTREE_TTS_MODEL=qwen3-tts-flash
MYTREE_TTS_PROTOCOL=qwen
MYTREE_TTS_VOICE=Cherry
MYTREE_TTS_API_BASE=https://dashscope.aliyuncs.com/api/v1
MYTREE_TTS_API_KEY=
MYTREE_EMBEDDING_MODEL=text-embedding-v4
MYTREE_EMBEDDING_DIMS=1024
# Every role supports MYTREE_{VISION,TUTOR,DIAGRAM,ASR,TTS,EMBEDDING}_API_BASE/API_KEY.
# A different role base REQUIRES its own key; no cross-provider key fallback.
# Optional official DeepSeek text/diagram (select actual available model):
# MYTREE_TUTOR_API_BASE=https://api.deepseek.com
# MYTREE_TUTOR_API_KEY=
# MYTREE_TUTOR_MODEL=deepseek-flash
# MYTREE_DIAGRAM_API_BASE=https://api.deepseek.com
# MYTREE_DIAGRAM_API_KEY=
# MYTREE_DIAGRAM_MODEL=deepseek-flash

# Email login (deploy.sh sets these in the private server environment).
# Local demo remains anonymous unless MYTREE_AUTH_MODE=email is exported.
# MYTREE_AUTH_MODE=email
# MYTREE_AUTH_SECRET=<random server-only secret>
# MYTREE_SMTP_HOST=smtp.qq.com
# MYTREE_SMTP_PORT=465
# MYTREE_SMTP_USER=1317483655@qq.com
# MYTREE_SMTP_FROM=1317483655@qq.com
# MYTREE_SMTP_PASSWORD=<QQ SMTP authorization code, never QQ login password>
# MYTREE_COOKIE_SECURE=0  # only for localhost HTTP development

# Optional official question-bank lookup; server only. Never put real secrets here.
# Prefer mytree/scripts/configure_questionbank.py for private local configuration.
MYTREE_YOUDAO_APP_KEY=
MYTREE_YOUDAO_APP_SECRET=
MYTREE_QUESTIONBANK_DAILY_LIMIT=20
# MYTREE_QUESTIONBANK_DB=/data/questionbank.sqlite3

# Mem0 OSS semantic memory; private persistent directory under /data in production.
MYTREE_MEM0_ENABLED=1
# MYTREE_MEM0_DIR=/data/mem0
# Uses independently configurable embedding endpoint; telemetry disabled in code.
# Different embedding models/dimensions use isolated indexes; source facts are retained.
